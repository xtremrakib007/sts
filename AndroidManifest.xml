<?xml version="1.0" encoding="utf-8"?>
<!--
  Place this at: android/app/src/main/AndroidManifest.xml
  REPLACE your existing manifest with this complete version.
  After saving, run: npx cap sync android
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Internet ── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ── Camera — outlet signboard photos & selfie check-in ── -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- ── Location — GPS pinning & distance display ── -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ── Push Notifications (FCM) ── -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── Storage — photo uploads ── -->
    <!-- Android 13+ (API 33+): use READ_MEDIA_IMAGES -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 12 and below: use READ/WRITE_EXTERNAL_STORAGE -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- ── Wake lock — keep screen on during active use ── -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true">

        <!-- ── Main Activity ── -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- ══════════════════════════════════════════════════════════════
             FCM PUSH NOTIFICATION SERVICE
             REQUIRED — without this, background/killed app never receives
             push notifications on Android. The service tag registers this
             app with the Firebase Messaging system at the OS level.
        ═══════════════════════════════════════════════════════════════ -->
        <service
            android:name="com.google.firebase.messaging.FirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- ── FCM default notification channel (Android 8+ requirement) ──
             The channel ID here MUST match the channel you create in
             MainActivity.java via NotificationChannel("fcm_default_channel")
             If these don't match, notifications are silently dropped.       -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="fcm_default_channel" />

        <!-- ── FCM notification icon — shows in status bar ── -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <!-- ── FCM notification accent color ── -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ic_launcher_background" />

        <!-- ── FileProvider — REQUIRED for camera photo capture on Android 7+ ──
             Without this, Camera.getPhoto() silently fails or crashes on real devices.
             The authority MUST match: applicationId + ".fileprovider"              -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
