{
  "name": "stfm-sales-app",
  "version": "1.0.0",
  "description": "STFM - Sairah Trading Sales & Distribution Management",
  "main": "index.js",
  "scripts": {
    "build": "node build.js",
    "sync": "node build.js && npx cap sync android",
    "open": "npx cap open android",
    "test:security": "node --test tests/security-regression.test.js",
    "test:erp-sync": "node --test tests/erp-sync.test.js",
    "test:order-controls": "node --test tests/order-controls.test.js",
    "test": "npm run test:security && npm run test:erp-sync && npm run test:order-controls && npm run test:native-app && npm run test:stock-ledger",
    "test:native-app": "node --test tests/native-app.test.js",
    "test:stock-ledger": "node --test tests/stock-ledger.test.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/geolocation": "^6.1.0",
    "@capacitor/push-notifications": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.4",
    "@capgo/capacitor-updater": "6.53.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "html-minifier-terser": "^7.2.0",
    "terser": "^5.39.0",
    "adm-zip": "0.6.1"
  },
  "stfm": {
    "otaMinNativeBuild": 2,
    "apkUrl": ""
  }
}
