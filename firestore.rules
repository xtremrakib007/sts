rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
// STFM — Firestore Security Rules
// ═══════════════════════════════════════════════════════════════════════════════
//
// Role hierarchy (stored in users/{uid}.role + .isOwner):
//   Owner / Super Admin  — role="admin", isOwner=true  → full cross-zone access
//   Admin (zone)         — role="admin", isOwner=false → own zone only
//   Sub Admin            — role="sub_admin"             → own zone, limited deletes
//   Sales Rep            — role="sales_rep"             → own zone, own records
//   Delivery Man         — role="delivery_man"          → own zone, assigned orders
//
// Portal users (stored in portalUsers/{uid}):
//   Separate Auth accounts — can read/create/update their own records only
//   Collections: orders, outlets, collections, products (root level)
//
// KEY FIX: ud() is now safe — returns empty map {} if user doc missing,
// so portal users (not in /users) no longer crash rule evaluation.
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // HELPERS
    // ─────────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Safe user doc fetch — returns {} if document doesn't exist
    // This prevents crashes when portal users (not in /users) hit any rule
    function ud() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    // Safe portal user doc fetch — returns {} if not a portal user
    function pd() {
      return exists(/databases/$(database)/documents/portalUsers/$(request.auth.uid))
        ? get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data
        : {};
    }

    // STFM role predicates
    // The owner account is either role 'admin' with isOwner: true, or role
    // 'super_admin' (the ERP's name for the same account).
    function _isOwner(u)       { return (u.get('role','') == 'admin' && u.get('isOwner', false) == true) || u.get('role','') == 'super_admin'; }
    function _isAdmin(u)       { return u.get('role','') == 'admin' || u.get('role','') == 'super_admin'; }
    function _isSubAdmin(u)    { return u.get('role','') == 'sub_admin'; }
    function _isAdminOrSub(u)  { return u.get('role','') in ['admin', 'sub_admin', 'super_admin']; }
    function _isSalesRep(u)    { return u.get('role','') == 'sales_rep'; }
    function _isDeliveryMan(u) { return u.get('role','') == 'delivery_man'; }
    function _isFieldUser(u)   { return u.get('role','') == 'sales_rep' || u.get('role','') == 'delivery_man'; }

    // Zone helpers
    function _inZone(u, zoneId)      { return _isOwner(u) || (u.get('zoneId','') != '' && zoneId != '' && u.get('zoneId','') == zoneId); }
    function _isZoneAdmin(u, zoneId) { return _isOwner(u) || (_isAdminOrSub(u) && u.get('zoneId','') != '' && zoneId != '' && u.get('zoneId','') == zoneId); }

    // Portal user check — is this auth uid a registered portal user?
    function isPortalUser() {
      return isSignedIn() && exists(/databases/$(database)/documents/portalUsers/$(request.auth.uid));
    }

    // Is this a valid STFM internal user (has a role)?
    function isStfmUser() {
      return isSignedIn() && ud().get('role','') != '';
    }

    function isAnyActiveUser() { return isSignedIn(); }

    // ─────────────────────────────────────────────────────────────────────────
    // PORTAL USERS  /portalUsers/{uid}
    // Separate collection for portal-only accounts
    // ─────────────────────────────────────────────────────────────────────────

    match /portalUsers/{uid} {
      // Portal user can read/update their own profile
      allow read:   if isSignedIn() && (request.auth.uid == uid || _isAdminOrSub(ud()));
      // Self-registration on first login
      allow create: if isSignedIn() && request.auth.uid == uid;
      // Self-update limited fields only
      allow update: if isSignedIn() && (
          _isAdminOrSub(ud())
          || (
            request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'name','phone','company','address','fcmToken','lastSeen','updatedAt'
              ])
          )
        );
      allow delete: if isSignedIn() && _isOwner(ud());
    }

    // ─────────────────────────────────────────────────────────────────────────
    // USERS  /users/{uid}
    // ─────────────────────────────────────────────────────────────────────────

    match /users/{uid} {
      // User profiles are private by default; allow owner, self, or same-zone staff.
      allow read: if isSignedIn() && (
          _isOwner(ud())
          || request.auth.uid == uid
          || (_isAdminOrSub(ud())
              && ud().get('zoneId','') != ''
              && resource.data.get('zoneId','') == ud().get('zoneId',''))
        );

      // Only trusted staff can provision staff accounts. No self-registration here.
      allow create: if isSignedIn() && (
          _isOwner(ud())
          || (
            _isAdminOrSub(ud())
            && ud().get('zoneId','') != ''
            && request.resource.data.get('zoneId','') == ud().get('zoneId','')
            && request.resource.data.get('isOwner', false) == false
            && request.resource.data.get('role','') in ['sub_admin','sales_rep','delivery_man']
            && (_isAdmin(ud()) || request.resource.data.get('role','') in ['sales_rep','delivery_man'])
          )
        );

      allow update: if isSignedIn() && (
          _isOwner(ud())
          || (
            request.auth.uid != uid
            && _isAdminOrSub(ud())
            && ud().get('zoneId','') != ''
            && resource.data.get('zoneId','') == ud().get('zoneId','')
            && request.resource.data.get('zoneId','') == resource.data.get('zoneId','')
            && request.resource.data.get('isOwner', false) == resource.data.get('isOwner', false)
            && (_isAdmin(ud()) || request.resource.data.get('role','') == resource.data.get('role',''))
            // Storemen see ERP-wide orders and stock, super_admin is the
            // owner: only the owner grants either.
            && (request.resource.data.get('role','') != 'storeman' || resource.data.get('role','') == 'storeman')
            && request.resource.data.get('role','') != 'super_admin'
            && resource.data.get('role','') != 'super_admin'
          )
          || (
            request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'fcmToken','lastSeen','pushEnabled','name','phone','avatar',
                'lastLat','lastLng','lastLocationAt','lastAccuracy'
              ])
          )
        );

      allow delete: if isSignedIn() && _isOwner(ud());
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ZONES  /zones/{zoneId}
    // ─────────────────────────────────────────────────────────────────────────

    match /zones/{zoneId} {
      allow read:           if isAnyActiveUser();
      allow create, update: if isSignedIn() && _isOwner(ud());
      allow delete:         if isSignedIn() && _isOwner(ud());

      // ── Zone sub-collections ──────────────────────────────────────────────

      match /orders/{orderId} {
        allow read: if isSignedIn() && _inZone(ud(), zoneId);

        allow create: if isSignedIn()
          && _inZone(ud(), zoneId)
          && (_isSalesRep(ud()) || _isAdminOrSub(ud()))
          && request.resource.data.createdBy == request.auth.uid;

        allow update: if isSignedIn() && (
            _isZoneAdmin(ud(), zoneId)
            || (
              _isSalesRep(ud()) && _inZone(ud(), zoneId)
              && resource.data.createdBy == request.auth.uid
              // Own order, only until the ERP accepts or invoices it.
              && resource.data.get('status', '') in ['Pending', 'Confirmed']
              && resource.data.get('invoiceNo', '') == ''
              && resource.data.get('erpStatus', '') in ['', 'pending']
              && (
                // Edit lines / notes (status unchanged; discount untouched)
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['items','subtotal','total','notes','updatedAt','editedAt','editedBy','editedByName'])
                // or cancel it, as themselves
                || (
                  request.resource.data.get('status', '') == 'Cancelled'
                  && request.resource.data.get('cancelledBy', '') == request.auth.uid
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status','cancelledAt','cancelledBy','cancelReason','updatedAt'])
                )
              )
            )
            || (
              _isDeliveryMan(ud()) && _inZone(ud(), zoneId)
              && resource.data.deliveryManId == request.auth.uid
              // Same transitions and fields as the root orders rule, so the
              // zone write and its root mirror succeed or fail together.
              && (
                (resource.data.get('status', '') == 'Assigned'
                  && request.resource.data.get('status', '') == 'In Transit')
                || (resource.data.get('status', '') == 'In Transit'
                  && request.resource.data.get('status', '') in ['Delivered', 'Failed'])
              )
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly([
                     'status','deliveryNote','updatedAt',
                     'inTransitAt','inTransitBy',
                     'deliveredAt','deliveredBy',
                     'failureReason','failedAt','failedBy',
                     'deliveryOutcome','partial','deliveredItems','deliveredTotal',
                     'receiverName','hasProof',
                     'paymentMethod','paymentAmount','paymentStatus','paymentAt',
                     'paymentRef','chequeBank','chequeDate'
                   ])
              && (
                !('inTransitBy' in request.resource.data)
                || request.resource.data.inTransitBy == request.auth.uid
              )
              && (
                !('deliveredBy' in request.resource.data)
                || request.resource.data.deliveredBy == request.auth.uid
              )
              && (
                !('failedBy' in request.resource.data)
                || request.resource.data.failedBy == request.auth.uid
              )
            )
          );

        allow delete: if isSignedIn() && _isAdmin(ud()) && _inZone(ud(), zoneId);
      }

      match /outlets/{outletId} {
        // Zone admins and the zone's field staff; storemen don't need outlets.
        allow read:   if isSignedIn() && (_isZoneAdmin(ud(), zoneId) || (_isFieldUser(ud()) && _inZone(ud(), zoneId)));
        allow create,
              update: if isSignedIn() && (
                  _isZoneAdmin(ud(), zoneId)
                  || (_isSalesRep(ud()) && _inZone(ud(), zoneId))
                );
        allow delete: if isSignedIn() && _isZoneAdmin(ud(), zoneId);
      }

      match /collections/{colId} {
        allow read: if isSignedIn() && (
            _isZoneAdmin(ud(), zoneId) || _isFieldUser(ud()) && _inZone(ud(), zoneId)
          );
        allow create: if isSignedIn()
          && _inZone(ud(), zoneId)
          && (
            _isAdminOrSub(ud())
            || (_isSalesRep(ud()) && request.resource.data.createdBy == request.auth.uid)
            // payment taken when completing a delivery (js/deliveries.js)
            || (_isDeliveryMan(ud()) && request.resource.data.createdBy == request.auth.uid
                && request.resource.data.get('source', '') == 'delivery')
          );
        allow update: if isSignedIn() && _isZoneAdmin(ud(), zoneId);
        allow delete: if isSignedIn() && _isAdmin(ud()) && _inZone(ud(), zoneId);
      }

      match /products/{productId} {
        allow read:   if isSignedIn() && _inZone(ud(), zoneId);
        allow create,
              update: if isSignedIn() && _isZoneAdmin(ud(), zoneId);
        allow delete: if isSignedIn() && _isAdmin(ud()) && _inZone(ud(), zoneId);
      }

      match /productOverrides/{productId} {
        allow read:  if isSignedIn() && _inZone(ud(), zoneId);
        allow write: if isSignedIn() && _isZoneAdmin(ud(), zoneId);
      }

      match /attendance/{recordId} {
        allow read: if isSignedIn() && (
            _isZoneAdmin(ud(), zoneId) || (_isFieldUser(ud()) && _inZone(ud(), zoneId))
          );
        allow create: if isSignedIn()
          && _inZone(ud(), zoneId)
          && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && _isAdminOrSub(ud()) && _inZone(ud(), zoneId);
        allow delete: if isSignedIn() && _isAdmin(ud()) && _inZone(ud(), zoneId);
      }

      match /visits/{visitId} {
        allow read: if isSignedIn() && (
            _isZoneAdmin(ud(), zoneId) || (_isSalesRep(ud()) && _inZone(ud(), zoneId))
          );
        allow create: if isSignedIn()
          && _inZone(ud(), zoneId)
          && (
            _isAdminOrSub(ud())
            || (_isSalesRep(ud()) && request.resource.data.createdBy == request.auth.uid)
          );
        allow update: if isSignedIn() && _isZoneAdmin(ud(), zoneId);
        allow delete: if isSignedIn() && _isAdmin(ud()) && _inZone(ud(), zoneId);
      }

      match /routes/{routeId} {
        allow read:   if isSignedIn() && _inZone(ud(), zoneId);
        allow create: if isSignedIn() && _inZone(ud(), zoneId)
          && (_isAdminOrSub(ud()) || _isSalesRep(ud()))
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isSignedIn() && (
            _isZoneAdmin(ud(), zoneId)
            || (_isSalesRep(ud()) && _inZone(ud(), zoneId)
                && resource.data.repId == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['name','description','updatedAt']))
          );
        allow delete: if isSignedIn() && _isZoneAdmin(ud(), zoneId);
      }

      match /broadcasts/{broadcastId} {
        allow read:  if isSignedIn() && _inZone(ud(), zoneId);
        allow write: if isSignedIn() && _isZoneAdmin(ud(), zoneId);
      }

      match /targets/{targetId} {
        allow read: if isSignedIn() && (
            _isZoneAdmin(ud(), zoneId) || (_isFieldUser(ud()) && _inZone(ud(), zoneId))
          );
        allow write: if isSignedIn() && _isZoneAdmin(ud(), zoneId);
      }

      match /deleteRequests/{reqId} {
        allow read:   if isSignedIn() && _isZoneAdmin(ud(), zoneId);
        allow create: if isSignedIn() && _inZone(ud(), zoneId);
        allow update: if isSignedIn() && _isZoneAdmin(ud(), zoneId);
        allow delete: if isSignedIn() && _isAdmin(ud()) && _inZone(ud(), zoneId);
      }

      match /users/{uid} {
        allow read:   if isSignedIn() && (_isZoneAdmin(ud(), zoneId) || request.auth.uid == uid);
        allow create,
              delete: if isSignedIn() && _isOwner(ud());
        allow update: if isSignedIn() && (
            _isOwner(ud())
            || (
              request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'fcmToken','fcmUpdatedAt','lastSeen','pushEnabled',
                  'lastLat','lastLng','lastLocationAt','lastAccuracy'
                ])
            )
          );
      }

      match /{subCol}/{docId} {
        // outlets have their own read rule above (no storemen)
        allow read:  if isSignedIn() && _inZone(ud(), zoneId) && subCol != 'outlets';
        allow write: if isSignedIn() && _isZoneAdmin(ud(), zoneId);
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ROOT MIRROR COLLECTIONS
    // Portal users can read + create + update their own records
    // ─────────────────────────────────────────────────────────────────────────

    match /orders/{orderId} {
      allow read: if isSignedIn() && (
          _isAdminOrSub(ud()) || _isSalesRep(ud()) || _isDeliveryMan(ud())
          // Portal: can only read their own orders
          || (isPortalUser() && resource.data.createdBy == request.auth.uid)
        );
      allow create: if isSignedIn() && (
          request.resource.data.createdBy == request.auth.uid
          // Portal users can create orders for themselves
          && (isStfmUser() || isPortalUser())
        );
      allow update: if isSignedIn() && (
          _isAdminOrSub(ud())
          || (
            _isSalesRep(ud())
            && resource.data.createdBy == request.auth.uid
            // Own order, only until the ERP accepts or invoices it.
            && resource.data.get('status', '') in ['Pending', 'Confirmed']
            && resource.data.get('invoiceNo', '') == ''
            && resource.data.get('erpStatus', '') in ['', 'pending']
            && (
              // Edit lines / notes (status unchanged; discount untouched)
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['items','subtotal','total','notes','updatedAt','editedAt','editedBy','editedByName'])
              // or cancel it, as themselves
              || (
                request.resource.data.get('status', '') == 'Cancelled'
                && request.resource.data.get('cancelledBy', '') == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['status','cancelledAt','cancelledBy','cancelReason','updatedAt'])
              )
            )
          )
          || (
            _isDeliveryMan(ud())
            && resource.data.deliveryManId == request.auth.uid
            // Delivery staff may only move an assigned order into transit,
            // then mark an in-transit order delivered or failed.
            && (
              (resource.data.get('status', '') == 'Assigned'
                && request.resource.data.get('status', '') == 'In Transit')
              || (resource.data.get('status', '') == 'In Transit'
                && request.resource.data.get('status', '') in ['Delivered', 'Failed'])
            )
            // Match the actual fields written by js/deliveries.js.
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly([
                   'status','deliveryNote','updatedAt',
                   'inTransitAt','inTransitBy',
                   'deliveredAt','deliveredBy',
                   'failureReason','failedAt','failedBy',
                   'deliveryOutcome','partial','deliveredItems','deliveredTotal',
                   'receiverName','hasProof',
                   'paymentMethod','paymentAmount','paymentStatus','paymentAt',
                   'paymentRef','chequeBank','chequeDate'
                 ])
            && (
              !('inTransitBy' in request.resource.data)
              || request.resource.data.inTransitBy == request.auth.uid
            )
            && (
              !('deliveredBy' in request.resource.data)
              || request.resource.data.deliveredBy == request.auth.uid
            )
            && (
              !('failedBy' in request.resource.data)
              || request.resource.data.failedBy == request.auth.uid
            )
          )
          // Portal: can update limited fields on their own orders
          || (
            isPortalUser()
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['items','notes','updatedAt'])
          )
        );
      allow delete: if isSignedIn() && _isAdmin(ud());
    }

    match /outlets/{outletId} {
      allow read: if isSignedIn() && (
          _isAdminOrSub(ud()) || _isSalesRep(ud())
          // Portal: read all outlets (so they can pick delivery address etc.)
          || isPortalUser()
        );
      allow create,
            update: if isSignedIn() && (
                _isAdminOrSub(ud()) || _isSalesRep(ud())
                // Portal: create/update only their own outlet record
                || (isPortalUser() && request.resource.data.createdBy == request.auth.uid)
              );
      allow delete: if isSignedIn() && _isAdmin(ud());
    }

    match /collections/{colId} {
      allow read: if isSignedIn() && (
          _isAdminOrSub(ud()) || _isSalesRep(ud()) || _isDeliveryMan(ud())
          // Portal: read only their own payment records
          || (isPortalUser() && resource.data.createdBy == request.auth.uid)
        );
      allow create: if isSignedIn() && (
          _isAdminOrSub(ud())
          || (_isSalesRep(ud()) && request.resource.data.createdBy == request.auth.uid)
          || (_isDeliveryMan(ud()) && request.resource.data.createdBy == request.auth.uid
              && request.resource.data.get('source', '') == 'delivery')
          // Portal: create their own payment records
          || (isPortalUser() && request.resource.data.createdBy == request.auth.uid)
        );
      allow update: if isSignedIn() && (
          _isAdminOrSub(ud())
          // Portal: update only their own collection, limited fields
          || (
            isPortalUser()
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['notes','updatedAt','proofImage'])
          )
        );
      allow delete: if isSignedIn() && _isAdmin(ud());
    }

    match /products/{productId} {
      // Portal users can read the product catalogue
      allow read:   if isSignedIn() && (_isAdminOrSub(ud()) || _isSalesRep(ud()) || isPortalUser());
      allow create,
            update: if isSignedIn() && _isAdminOrSub(ud());
      allow delete: if isSignedIn() && _isAdmin(ud());
    }

    match /attendance/{recordId} {
      allow read: if isSignedIn() && (_isAdminOrSub(ud()) || _isFieldUser(ud()));
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && _isAdminOrSub(ud());
      allow delete: if isSignedIn() && _isAdmin(ud());
    }

    match /visits/{visitId} {
      allow read: if isSignedIn() && (_isAdminOrSub(ud()) || _isSalesRep(ud()));
      allow create: if isSignedIn() && (
          _isAdminOrSub(ud())
          || (_isSalesRep(ud()) && request.resource.data.createdBy == request.auth.uid)
        );
      allow update: if isSignedIn() && _isAdminOrSub(ud());
      allow delete: if isSignedIn() && _isAdmin(ud());
    }

    match /routes/{routeId} {
      allow read:   if isAnyActiveUser();
      allow create: if isSignedIn()
        && (_isAdminOrSub(ud()) || _isSalesRep(ud()))
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && (
          _isAdminOrSub(ud())
          || (_isSalesRep(ud())
              && resource.data.repId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['name','description','updatedAt']))
        );
      allow delete: if isSignedIn() && _isAdminOrSub(ud());
    }

    match /broadcasts/{broadcastId} {
      allow read:  if isAnyActiveUser();
      allow write: if isSignedIn() && _isAdminOrSub(ud());
    }

    match /targets/{targetId} {
      allow read: if isSignedIn() && (_isAdminOrSub(ud()) || _isFieldUser(ud()));
      allow write: if isSignedIn() && _isAdminOrSub(ud());
    }

    match /deleteRequests/{reqId} {
      allow read: if isSignedIn() && _isAdminOrSub(ud());
      // Only an authenticated STFM staff account may submit a well-formed
      // request for itself. Portal-only accounts cannot inject staff requests.
      allow create: if isSignedIn()
        && isStfmUser()
        && request.resource.data.get('requestedBy', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('itemType', '') in [
          'outlet', 'order', 'collection', 'product', 'route', 'broadcast'
        ]
        && request.resource.data.get('reason', '') is string
        && request.resource.data.get('reason', '').size() > 0
        && (
          _isOwner(ud())
          || !('zoneId' in ud())
          || ud().get('zoneId', '') == ''
          || request.resource.data.get('_zoneId', ud().get('zoneId', '')) == ud().get('zoneId', '')
        );
      allow update: if isSignedIn() && _isAdminOrSub(ud());
      allow delete: if isSignedIn() && _isAdmin(ud());
    }

    // ─────────────────────────────────────────────────────────────────────────
    // DEVICE APPROVAL
    // ─────────────────────────────────────────────────────────────────────────

    match /deviceApprovalRequests/{requestId} {
      allow create: if isSignedIn();
      allow read:   if isSignedIn() && (
          _isAdminOrSub(ud()) || request.auth.uid == resource.data.uid
        );
      allow update: if isSignedIn() && _isAdminOrSub(ud());
      allow delete: if isSignedIn() && _isAdmin(ud());
    }

    match /deviceApprovals/{uid}/devices/{deviceId} {
      allow read:  if isSignedIn() && (request.auth.uid == uid || _isAdminOrSub(ud()));
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (
          _isAdminOrSub(ud())
          || (
            request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['status','approvedBy','approvedAt','rejectedBy','rejectedAt'])
          )
        );
      allow delete: if isSignedIn() && _isAdminOrSub(ud());
    }

    // ─────────────────────────────────────────────────────────────────────────
    // CONFIG / SETTINGS
    // ─────────────────────────────────────────────────────────────────────────

    match /config/{docId} {
      allow read:  if isSignedIn() && (_isAdminOrSub(ud()) || _isFieldUser(ud()));
      allow write: if isSignedIn() && _isOwner(ud());
    }

    match /settings/{docId} {
      allow read:  if isSignedIn() && _isAdminOrSub(ud());
      allow write: if isSignedIn() && _isOwner(ud());
    }

    // ─────────────────────────────────────────────────────────────────────────
    // FCM TOKENS
    // ─────────────────────────────────────────────────────────────────────────

    match /fcmTokens/{uid} {
      allow read:   if isSignedIn() && (_isAdminOrSub(ud()) || request.auth.uid == uid);
      allow create,
            update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSignedIn() && (_isOwner(ud()) || request.auth.uid == uid);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ADMIN NOTIFICATIONS
    // ─────────────────────────────────────────────────────────────────────────

    match /admin_notifications/{id} {
      allow create: if isSignedIn() && _isAdminOrSub(ud());
      allow read:   if isSignedIn() && _isAdminOrSub(ud());
      allow update: if isSignedIn() && _isAdminOrSub(ud());
    }

    match /notification_history/{id} {
      allow read:   if isSignedIn() && _isAdminOrSub(ud());
      allow create: if isSignedIn() && _isAdminOrSub(ud());
      allow update,
            delete: if isSignedIn() && _isOwner(ud());
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PUSH QUEUE
    // ─────────────────────────────────────────────────────────────────────────

    match /pushQueue/{docId} {
      // Queue writes must originate from trusted server code (Admin SDK bypasses rules).
      allow create: if false;
      allow read, update: if isSignedIn() && _isAdminOrSub(ud());
      allow delete: if isSignedIn() && _isOwner(ud());
    }

    // AUDIT LOG — append-only events from authenticated internal users.
    // Proof of delivery (photo, receiver, GPS), one per app order. Written
    // once by the delivery man completing the delivery; never edited.
    match /deliveryProofs/{orderDocId} {
      allow read: if isSignedIn() && (_isAdminOrSub(ud()) || resource.data.deliveredBy == request.auth.uid);
      allow create: if isSignedIn()
        && (_isDeliveryMan(ud()) || _isAdminOrSub(ud()))
        && request.resource.data.deliveredBy == request.auth.uid
        && request.resource.data.get('photo', '').size() < 400000;
      allow update, delete: if false;
    }

    match /audit_log/{entryId} {
      allow read: if isSignedIn() && _isAdminOrSub(ud());
      allow create: if isSignedIn() && isStfmUser()
        && request.resource.data.keys().hasOnly(['action','userId','userName','userRole','details','timestamp','ts_client'])
        && request.resource.data.get('action', '') is string
        && request.resource.data.get('action', '').size() > 0
        && request.resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.get('userName', '') is string
        && request.resource.data.get('userRole', '') is string
        && request.resource.data.get('details', {}) is map
        && request.resource.data.get('timestamp', null) is timestamp
        && request.resource.data.get('ts_client', 0) is number;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // STSB ERP tenant collections
    //
    // The ERP portal uses the shared stfm-sales project and the stsb_* namespace.
    // Keep tenant data closed to ordinary users: only the verified owner account
    // (or an explicitly provisioned super_admin profile) can browse/manage the
    // full ERP dataset. Sales reps may submit only their own ERP order records.
    // ─────────────────────────────────────────────────────────────────────────
    function stsbProfile() {
      return exists(/databases/$(database)/documents/stsb_users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/stsb_users/$(request.auth.uid)).data
        : ud();
    }

    function isStsbERPAdmin() {
      return isSignedIn() && (
        _isOwner(stsbProfile()) || stsbProfile().get('role', '') == 'super_admin'
      );
    }

    // Warehouse storeman: reads orders and stock, packs orders and raises
    // stock requests. Cannot see finance, approve or change prices.
    function isStsbStoreman() {
      return isSignedIn()
        && stsbProfile().get('role', '') == 'storeman'
        && stsbProfile().get('status', 'active') == 'active';
    }

    function isStsbStaff() { return isStsbERPAdmin() || isStsbStoreman(); }

    match /stsb_users/{uid} {
      allow read: if isStsbERPAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create, update, delete: if isStsbERPAdmin();
    }

    match /stsb_products/{productId} {
      allow read: if isStsbStaff();
      allow create, update, delete: if isStsbERPAdmin();
    }

    match /stsb_orders/{orderId} {
      allow read: if isStsbStaff()
        || (isSignedIn() && stsbProfile().get('role', '') == 'sales_rep' && resource.data.repId == request.auth.uid);
      allow create: if isSignedIn()
        && stsbProfile().get('role', '') == 'sales_rep'
        && request.resource.data.repId == request.auth.uid;
      allow update: if isStsbERPAdmin()
        || (isStsbStoreman()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['pickStatus', 'pickedBy', 'pickedByName', 'pickStartedAt', 'packedAt', 'pickNote', 'updatedAt'])
            && request.resource.data.get('pickStatus', '') in ['', 'picking', 'packed']);
      allow delete: if isStsbERPAdmin();
    }

    // Stock quantities, average cost and reservations change only through
    // the server (stock requests and the order bridge), so every change has
    // a ledger entry. Item details (name, SKU, prices, reorder level) stay
    // editable by ERP admins; new items start at zero and get opening stock
    // through a stock request.
    match /stsb_inventory/{itemId} {
      allow read: if isStsbStaff();
      allow delete: if isStsbERPAdmin();
      allow create: if isStsbERPAdmin()
        && request.resource.data.get('qty', 0) == 0
        && request.resource.data.get('reservedQty', 0) == 0
        && !('reservations' in request.resource.data)
        && !('avgCost' in request.resource.data);
      allow update: if isStsbERPAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['qty', 'reservedQty', 'reservations', 'avgCost', 'lastMovementAt']);
    }

    // Stock movement requests: created by an ERP admin as themselves, then
    // posted by the erpStockRequest function. The only client change after
    // that is a different admin approving or rejecting a held request.
    match /stsb_stock_requests/{reqId} {
      allow read: if isStsbERPAdmin()
        || (isStsbStoreman() && resource.data.requestedBy == request.auth.uid);
      allow create: if isStsbERPAdmin()
        && request.resource.data.status == 'requested'
        && request.resource.data.requestedBy == request.auth.uid;
      // Storeman requests are tagged so adjustments always wait for an admin.
      allow create: if isStsbStoreman()
        && request.resource.data.status == 'requested'
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedByRole == 'storeman'
        && request.resource.data.type in ['receipt', 'adjust_in', 'adjust_out', 'damage', 'expiry', 'count', 'transfer_in', 'transfer_out', 'return_in'];
      allow update: if isStsbERPAdmin()
        && resource.data.status == 'pending_approval'
        && request.resource.data.status in ['approved', 'rejected']
        && resource.data.requestedBy != request.auth.uid
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'approvedBy', 'approvedByName', 'decidedAt', 'decisionNote']);
      allow delete: if false;
    }

    // Immutable movement history and per-order stock state: server-written.
    match /stsb_stock_ledger/{entryId} {
      allow read: if isStsbStaff();
      allow write: if false;
    }

    match /stsb_stock_moves/{orderId} {
      allow read: if isStsbERPAdmin();
      allow write: if false;
    }

    // Sales returns: raised by an ERP admin, priced and posted by the
    // erpReturn function; only a different admin can approve or reject.
    match /stsb_returns/{retId} {
      allow read: if isStsbERPAdmin();
      allow create: if isStsbERPAdmin()
        && request.resource.data.status == 'pending_approval'
        && request.resource.data.requestedBy == request.auth.uid
        && !('priced' in request.resource.data)
        && !('amount' in request.resource.data);
      allow update: if isStsbERPAdmin()
        && resource.data.status == 'pending_approval'
        && resource.data.get('priced', false) == true
        && request.resource.data.status in ['approved', 'rejected']
        && resource.data.requestedBy != request.auth.uid
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'approvedBy', 'approvedByName', 'decidedAt', 'decisionNote']);
      allow delete: if false;
    }

    match /stsb_credit_notes/{cnId} {
      allow read: if isStsbERPAdmin();
      allow write: if false;
    }

    match /stsb_invoices/{invoiceId} {
      allow read, create, update, delete: if isStsbERPAdmin();
    }

    // LHDN e-Invoice requests from buyers scanning the invoice QR code (no
    // sign-in). One request per invoice (doc id = invoice no.), accepted only
    // with the random token printed in that invoice's QR code. The buyer can
    // correct it while it is still pending; ERP admins process it.
    function einvBuyerFields() {
      return ['invoiceNo', 'token', 'buyerType', 'buyerName', 'tin', 'idType', 'idNo', 'sstNo',
              'email', 'phone', 'addressLine', 'postcode', 'city', 'state', 'country', 'notes',
              'status', 'createdAt'];
    }

    function validEinvRequest(invNo) {
      let d = request.resource.data;
      let inv = /databases/$(database)/documents/stsb_invoices/$(invNo);
      return d.keys().hasOnly(einvBuyerFields())
        && d.keys().hasAll(['invoiceNo', 'token', 'buyerType', 'buyerName', 'tin', 'idType', 'idNo',
                            'email', 'phone', 'addressLine', 'postcode', 'city', 'state', 'status', 'createdAt'])
        && d.invoiceNo == invNo
        && d.status == 'pending'
        && d.createdAt == request.time
        && d.token is string && d.token.size() == 32
        && exists(inv) && get(inv).data.get('einvoiceToken', '') == d.token
        && get(inv).data.get('status', '') != 'void'
        && d.buyerType in ['company', 'individual']
        && d.idType in ['BRN', 'NRIC', 'PASSPORT', 'ARMY']
        && d.buyerName is string && d.buyerName.size() > 0 && d.buyerName.size() <= 200
        && d.tin is string && d.tin.size() >= 9 && d.tin.size() <= 20
        && d.idNo is string && d.idNo.size() > 0 && d.idNo.size() <= 30
        && d.email is string && d.email.size() <= 120
        && d.phone is string && d.phone.size() <= 20
        && d.addressLine is string && d.addressLine.size() <= 200
        && d.postcode is string && d.postcode.size() <= 10
        && d.city is string && d.city.size() <= 60
        && d.state is string && d.state.size() <= 40
        && d.get('sstNo', '') is string && d.get('sstNo', '').size() <= 40
        && d.get('notes', '') is string && d.get('notes', '').size() <= 300
        && d.get('country', 'MYS') == 'MYS';
    }

    match /stsb_einvoice_requests/{invNo} {
      allow read, delete: if isStsbERPAdmin();
      allow create: if validEinvRequest(invNo);
      allow update: if (resource.data.status == 'pending' && validEinvRequest(invNo))
        || (isStsbERPAdmin()
            && request.resource.data.status in ['pending', 'processing', 'issued', 'rejected']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'lhdnUuid', 'lhdnLongId', 'validationUrl', 'adminNote',
                           'processedBy', 'processedByName', 'processedAt']));
    }

    // Staff advances: any Sales App user may request an advance for
    // themselves and cancel it while it waits; only ERP admins approve, pay
    // out and record deductions / repayments. Staff read only their own.
    function validAdvanceRequest() {
      let d = request.resource.data;
      return isSignedIn() && isStfmUser()
        && d.keys().hasOnly(['uid', 'staffName', 'staffRole', 'zoneId', 'type', 'amount', 'instalments', 'reason', 'status', 'requestedAt'])
        && d.uid == request.auth.uid
        && d.status == 'pending'
        && d.staffRole == ud().get('role', '')
        && d.staffName is string && d.staffName.size() <= 120
        && d.type in ['salary', 'cash', 'loan', 'other']
        && d.amount is number && d.amount > 0 && d.amount <= 100000
        && d.instalments is int && d.instalments >= 1 && d.instalments <= 24
        && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 500
        && d.requestedAt is string;
    }

    match /stsb_staff_advances/{advId} {
      allow read: if isStsbERPAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isStsbERPAdmin() || validAdvanceRequest();
      allow update: if isStsbERPAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']));
      allow delete: if isStsbERPAdmin();
    }

    match /stsb_suppliers/{supplierId} {
      allow read, create, update, delete: if isStsbERPAdmin();
    }

    match /stsb_transfers/{transferId} {
      allow read, create, update, delete: if isStsbERPAdmin();
    }

    match /stsb_hq_orders/{orderId} {
      allow read, create, update, delete: if isStsbERPAdmin();
    }

    match /stsb_collections/{collectionId} {
      allow read, create, update, delete: if isStsbERPAdmin();
    }

    match /stsb_config/{configId} {
      allow read, create, update, delete: if isStsbERPAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // CATCH-ALL — deny everything not matched above
    // ─────────────────────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
