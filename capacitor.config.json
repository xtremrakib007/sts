{
  "appId": "com.sairah.stfm",
  "appName": "STFM Sales",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0d1117",
      "showSpinner": false
    },
    "Camera": {
      "presentationStyle": "fullscreen"
    }
  }
}
